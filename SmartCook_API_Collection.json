{
  "info": {
    "_postman_id": "7a9b0c1d-2e3f-4a5b-6c7d-8e9f0a1b2c3d",
    "name": "SmartCook Production API Collection (Phases 1-7)",
    "description": "Toàn bộ tài liệu kiểm thử và kết nối API hệ sinh thái SmartCook Backend chuẩn Production (Node.js, Express, MongoDB Atlas, Socket.io, Gemini AI & Cloudinary).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication & Onboarding",
      "item": [
        {
          "name": "Register New Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Hoàng\",\n  \"lastName\": \"Minh\",\n  \"email\": \"chef@smartcook.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chef@smartcook.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Silent Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] }
          }
        },
        {
          "name": "Get Profile Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Update Onboarding Survey",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portion\": \"3-4\",\n  \"cuisines\": [\"vietnamese\", \"healthy\"],\n  \"healthGoal\": \"healthy\",\n  \"restrictions\": [\"no-spicy\"],\n  \"tasteProfile\": [\"dam-da\"],\n  \"cookingTime\": \"quick\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/survey", "host": ["{{baseUrl}}"], "path": ["auth", "survey"] }
          }
        }
      ]
    },
    {
      "name": "2. Categories & Ingredients Master Data",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Search Ingredients (14 Groups)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ingredients?category=meat&search=gà",
              "host": ["{{baseUrl}}"],
              "path": ["ingredients"],
              "query": [
                { "key": "category", "value": "meat" },
                { "key": "search", "value": "gà" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Smart Fridge Management",
      "item": [
        {
          "name": "Get User Fridge Items",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/fridge/my-fridge", "host": ["{{baseUrl}}"], "path": ["fridge", "my-fridge"] }
          }
        },
        {
          "name": "Add Item to Fridge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Thịt ức gà\",\n  \"amount\": \"500g\",\n  \"category\": \"meat\",\n  \"storageLocation\": \"chilled\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/fridge/items", "host": ["{{baseUrl}}"], "path": ["fridge", "items"] }
          }
        }
      ]
    },
    {
      "name": "4. Recipes & Fridge Match",
      "item": [
        {
          "name": "Get Recipes List",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/recipes?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["recipes"] }
          }
        },
        {
          "name": "Get Fridge Matched Recipes (Ranked %)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/recipes/fridge-match?limit=10", "host": ["{{baseUrl}}"], "path": ["recipes", "fridge-match"] }
          }
        },
        {
          "name": "Create Custom Recipe (User / Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Gà Nướng Mật Ong Tiêu Xanh\",\n  \"categoryCode\": \"quick\",\n  \"minutes\": 30,\n  \"difficulty\": \"Dễ\",\n  \"calories\": 480,\n  \"description\": \"Món gà nướng vàng giòn thơm lừng\",\n  \"ingredients\": [\n    { \"name\": \"Thịt đùi gà\", \"amount\": \"400g\" },\n    { \"name\": \"Mật ong\", \"amount\": \"2 muỗng\" }\n  ],\n  \"steps\": [\n    { \"stepNumber\": 1, \"title\": \"Ướp gà\", \"description\": \"Ướp mật ong và tiêu trong 15 phút\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/recipes", "host": ["{{baseUrl}}"], "path": ["recipes"] }
          }
        }
      ]
    },
    {
      "name": "5. Chef XP & Cooking History",
      "item": [
        {
          "name": "Record Cooked Dish (+50 XP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipeId\": \"6ab0fe5e2aec9ea6b60b19bf\",\n  \"recipeName\": \"Canh Chua Cá Hồi\",\n  \"durationMinutes\": 25,\n  \"servings\": 2,\n  \"calories\": 420\n}"
            },
            "url": { "raw": "{{baseUrl}}/cooking-history", "host": ["{{baseUrl}}"], "path": ["cooking-history"] }
          }
        },
        {
          "name": "Get Cooking History List",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/cooking-history?limit=10", "host": ["{{baseUrl}}"], "path": ["cooking-history"] }
          }
        }
      ]
    },
    {
      "name": "6. Gemini AI Vision & Chatbot",
      "item": [
        {
          "name": "Scan Tabletop / Fridge Ingredients (Gemini Vision)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/ai/scan-ingredients", "host": ["{{baseUrl}}"], "path": ["ai", "scan-ingredients"] }
          }
        },
        {
          "name": "AI Chef Assistant Chat (Injected Fridge Context)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Tủ lạnh mình có gà và cà chua, làm món gì ngon nhanh gọn?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai/assistant-chat", "host": ["{{baseUrl}}"], "path": ["ai", "assistant-chat"] }
          }
        }
      ]
    },
    {
      "name": "7. Community Social Feed & Reactions",
      "item": [
        {
          "name": "Get Community Posts Feed",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Create Community Post",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Cơm Gà Da Giòn Cuối Tuần", "type": "text" },
                { "key": "caption", "value": "Công thức nướng nồi chiên không dầu thơm ngon!", "type": "text" },
                { "key": "tags", "value": "[\"#MonNgon\", \"#EatClean\"]", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Like / React to Post",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/posts/:id/like", "host": ["{{baseUrl}}"], "path": ["posts", ":id", "like"] }
          }
        },
        {
          "name": "Add Comment to Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Món ăn nhìn hấp dẫn quá bạn ơi!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts/:id/comments", "host": ["{{baseUrl}}"], "path": ["posts", ":id", "comments"] }
          }
        }
      ]
    },
    {
      "name": "8. Realtime Chat & Socket.io Gateway",
      "item": [
        {
          "name": "Get Seeded Chat Rooms",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/chat/rooms", "host": ["{{baseUrl}}"], "path": ["chat", "rooms"] }
          }
        },
        {
          "name": "Get Direct Conversations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/chat/conversations", "host": ["{{baseUrl}}"], "path": ["chat", "conversations"] }
          }
        },
        {
          "name": "Get Conversation Messages History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/chat/conversations/:id/messages", "host": ["{{baseUrl}}"], "path": ["chat", "conversations", ":id", "messages"] }
          }
        }
      ]
    },
    {
      "name": "9. Meal Planner & Smart Shopping List",
      "item": [
        {
          "name": "Get Current Week Plan",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/planner/current-week", "host": ["{{baseUrl}}"], "path": ["planner", "current-week"] }
          }
        },
        {
          "name": "Set Meal Slot for Day",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": \"Thứ 2\",\n  \"slot\": \"Bữa Trưa\",\n  \"time\": \"12:00\",\n  \"customTitle\": \"Cơm Gà Áp Chảo\",\n  \"calories\": 550\n}"
            },
            "url": { "raw": "{{baseUrl}}/planner/meals", "host": ["{{baseUrl}}"], "path": ["planner", "meals"] }
          }
        },
        {
          "name": "Get Smart Shopping List (Fridge Deducted)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/planner/shopping-list", "host": ["{{baseUrl}}"], "path": ["planner", "shopping-list"] }
          }
        },
        {
          "name": "Toggle Item Bought Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bought\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/planner/shopping-list/:id/bought", "host": ["{{baseUrl}}"], "path": ["planner", "shopping-list", ":id", "bought"] }
          }
        },
        {
          "name": "1-Click Sync Bought Items to Fridge",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/planner/sync-to-fridge", "host": ["{{baseUrl}}"], "path": ["planner", "sync-to-fridge"] }
          }
        }
      ]
    },
    {
      "name": "10. GPS Nearby Stores ($geoNear 2dsphere)",
      "item": [
        {
          "name": "Find Nearby Supermarkets by GPS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stores/nearby?lat=10.7769&lng=106.6909&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "nearby"],
              "query": [
                { "key": "lat", "value": "10.7769" },
                { "key": "lng", "value": "106.6909" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get All Stores List",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/stores", "host": ["{{baseUrl}}"], "path": ["stores"] }
          }
        }
      ]
    },
    {
      "name": "11. Web Admin Management",
      "item": [
        {
          "name": "Admin KPI Dashboard",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "Admin Users List",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/users?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Update User Status (Lock/Unlock)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/users/:userId/status", "host": ["{{baseUrl}}"], "path": ["admin", "users", ":userId", "status"] }
          }
        }
      ]
    }
  ]
}
