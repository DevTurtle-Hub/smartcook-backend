%% SmartCook Ecosystem - Complete Technology Stack Architecture
%% Visualizing technologies across Mobile, Web, Backend, Database, Cloud & DevOps

flowchart TB
    %% ========================================================
    %% CLIENT LAYER
    %% ========================================================
    subgraph CLIENT_LAYER["📱 1. CLIENT APPLICATIONS LAYER"]
        direction TB

        subgraph MOBILE_TECH["📲 SmartCook Mobile (iOS & Android)"]
            M_CORE["<b>Core & Framework</b><br/>• React Native 0.86<br/>• React 19 & TypeScript<br/>• Expo SDK 57 (Expo Router)"]
            M_UI["<b>UI & Animation</b><br/>• React Native Reanimated 4<br/>• React Native Gesture Handler<br/>• Expo Linear Gradient & Glass Effect<br/>• Expo Image & Vector Icons"]
            M_HARDWARE["<b>Native Hardware APIs</b><br/>• Expo Secure Store (Keystore/Keychain)<br/>• Expo Location (GPS Nearby Stores)<br/>• Expo Speech (Voice Cooking Assistant)<br/>• Expo Image Picker & Haptics"]
            M_NET["<b>Client Networking</b><br/>• Axios Client (Auth Interceptor)<br/>• Socket.IO Client (Realtime Chat)"]
        end

        subgraph WEB_TECH["💻 SmartCook Web (User & Admin Portal)"]
            W_CORE["<b>Core & Framework</b><br/>• React 19 & TypeScript<br/>• Vite 8 Build Tool (ESBuild)"]
            W_UI["<b>Design & UI Components</b><br/>• TailwindCSS v4<br/>• Lucide React Icons<br/>• Glassmorphic Dashboard UI"]
            W_STATE["<b>State & Data Management</b><br/>• Zustand (Atomic Auth Store)<br/>• TanStack Query v5 (React Query)"]
            W_NET["<b>Web Networking & Server</b><br/>• Axios (Atomic Token Rotation)<br/>• Socket.IO Client<br/>• Nginx 1.27 Alpine (SPA Server)"]
        end
    end

    %% ========================================================
    %% BACKEND SERVICES LAYER
    %% ========================================================
    subgraph BACKEND_LAYER["⚙️ 2. BACKEND API & REALTIME SERVICE LAYER"]
        direction TB

        subgraph BACKEND_CORE["🚀 SmartCook Backend Core"]
            B_RUNTIME["<b>Runtime & Framework</b><br/>• Node.js 20 LTS Alpine<br/>• Express.js 5.x<br/>• TypeScript 7.x (Strict Mode)"]
            B_REALTIME["<b>Realtime Gateway</b><br/>• Socket.IO 4.8<br/>• Chat Direct & Group Rooms<br/>• Membership Access Guard"]
            B_SECURITY["<b>Security & Hardening</b><br/>• JWT (Access & Refresh Rotation)<br/>• Bcrypt.js (12 Salt Rounds)<br/>• Helmet (HTTP Security Headers)<br/>• Express Rate Limit (Brute-Force Guard)<br/>• Express Mongo Sanitize (NoSQL Guard)<br/>• HPP (Parameter Pollution Guard)"]
            B_VALID_DOCS["<b>Validation & Documentation</b><br/>• Joi Schema Validation<br/>• Swagger UI & OpenAPI 3.0"]
            B_LOGGING["<b>Observability & Logging</b><br/>• Winston Structured JSON Logger<br/>• Winston Daily Rotate File (.gz)<br/>• Morgan HTTP Access Stream"]
        end
    end

    %% ========================================================
