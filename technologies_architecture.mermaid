        subgraph CACHE_TECH["⚡ In-Memory Caching"]
            REDIS["<b>Redis 7.0 Alpine</b><br/>• ioredis Driver<br/>• Multi-tier TTL (24h/12h/6h/30m)<br/>• Pattern Auto-Invalidation<br/>• Fallback: High-Speed In-Memory Cache"]
        end

        subgraph DB_TECH["🍃 Primary Database"]
            MONGO["<b>MongoDB Atlas 7.0</b><br/>• ODM: Mongoose 9.x<br/>• Full-Text Search Indexes (Weights)<br/>• Mongoose Soft Delete Plugin<br/>• TTL Indexes (Automatic OTP Expiry)<br/>• Cursor-based Pagination (_id lt cursor)"]
        end
    end

