%% SmartCook Backend - Physical MongoDB Collections ERD
%% Verified against the current MongoDB database and src/models/*.ts.
%% Exactly 18 physical collections are shown below.
%% Embedded subdocuments are represented as fields inside their parent collection.
%% Logical links use strings or polymorphic ids rather than enforced MongoDB foreign keys.

erDiagram
    USERS {
        ObjectId _id PK
        string firstName
        string lastName
        string email UK
        string password "hidden hashed value"
        string googleId UK
        string authType "local google facebook"
        string avatar
        string role "user admin"
        number chefExp
        string level
        object preferences "embedded survey data"
        ObjectId favoriteRecipeIds FK "embedded ObjectId array"
        object claimedRewards "embedded array"
        object checkIn "embedded object"
        string refreshToken "hidden value"
        boolean isActive
        boolean isDeleted
        datetime deletedAt
        ObjectId deletedBy FK
        datetime createdAt
        datetime updatedAt
    }

    PASSWORDRESETOTPS {
        ObjectId _id PK
        string email FK "logical USERS.email link"
        string otpHash
        datetime expiresAt "TTL index"
        boolean isUsed
        number attempts
        datetime createdAt
        datetime updatedAt
    }

    CATEGORIES {
        ObjectId _id PK
        string code UK
        string name
        string icon
        number order
        string description
        boolean isActive
        datetime createdAt
        datetime updatedAt
    }

    INGREDIENTS {
        ObjectId _id PK
        string name
        string normalizedName
        string aliases "embedded string array"
        string category FK "logical CATEGORIES.code link"
        string subCategory
        string icon
        string defaultUnit
        number averagePrice
        boolean isActive
        datetime createdAt
        datetime updatedAt
    }

    RECIPES {
        ObjectId _id PK
        string title
        string author
        ObjectId authorId FK
        number calories
        number minutes
        string difficulty
        string servings
        number servingsCount
        string price
        number rating
        number reviewCount
        string categoryCode FK "logical CATEGORIES.code link"
        string badge
        string sub
        string tags "embedded string array"
        string image
        string description
        object ingredients "embedded recipe ingredient array"
        object steps "embedded cooking step array"
        object nutrition "embedded nutrition object"
        boolean isActive
        boolean isDeleted
        datetime deletedAt
        ObjectId deletedBy FK
        datetime createdAt
        datetime updatedAt
    }

    USERFRIDGES {
        ObjectId _id PK
        ObjectId userId FK, UK
        object items "embedded fridge item array"
        datetime createdAt
        datetime updatedAt
    }

    COOKING_HISTORIES {
        ObjectId _id PK
        ObjectId userId FK
        ObjectId recipeId FK
        string recipeName
        string image
        datetime cookedAt
        number durationMinutes
        number servings
        string usedIngredients "embedded string array"
        number calories
        number rating
        number xpEarned
        datetime createdAt
        datetime updatedAt
    }

    SCANHISTORIES {
        ObjectId _id PK
        ObjectId userId FK
        string title
        string imageUrl
        string imagePublicId
        number accuracy
        object ingredients "embedded detected ingredients"
        object pins "embedded bounding pins"
        object suggestedRecipe "embedded suggestion"
        datetime scannedAt
        datetime createdAt
        datetime updatedAt
    }

    MEALPLANS {
        ObjectId _id PK
        ObjectId userId FK
        datetime weekStartDate UK "unique together with userId"
        object days "embedded days and meal slots"
        datetime createdAt
        datetime updatedAt
    }

    CARTITEMS {
        ObjectId _id PK
        ObjectId userId FK
        string name
        string normalizedName
        string amount
        number price
        string category
        string recipeTitle
        ObjectId recipeId FK "optional"
        boolean bought
        boolean isAutoGenerated
        boolean syncedToFridge
        datetime addedAt
        datetime createdAt
        datetime updatedAt
    }

    POSTS {
        ObjectId _id PK
        ObjectId author FK
        string dishName
        string caption
        object images "embedded image array"
        ObjectId recipeId FK "optional"
        string tags "embedded string array"
        map reactions "userId to reaction type"
        object reactionCounts "embedded counters"
        number totalReactions
        number commentsCount
        number sharesCount
        boolean isPinned
        string status
        boolean isDeleted
        datetime deletedAt
        ObjectId deletedBy FK
        datetime createdAt
        datetime updatedAt
    }

    COMMENTS {
        ObjectId _id PK
        ObjectId postId FK
        ObjectId author FK
        string content
        ObjectId parentCommentId FK "optional self reference"
        number likesCount
        boolean isDeleted
        datetime deletedAt
        ObjectId deletedBy FK
        datetime createdAt
        datetime updatedAt
    }

    CONVERSATIONS {
        ObjectId _id PK
        string type "direct room"
        ObjectId participants FK "embedded User ObjectId array"
        object members "embedded member array"
        string roomCode UK
        string title
        string description
        string iconName
        string tags "embedded string array"
        boolean isAiBot
        string lastMessage
        datetime lastMessageTime
        ObjectId lastSender FK
        number activeMembers
        datetime createdAt
        datetime updatedAt
    }

    MESSAGES {
        ObjectId _id PK
        ObjectId conversationId FK
        ObjectId sender FK
        string text
        string imageUri
        string imagePublicId
        ObjectId readBy FK "embedded User ObjectId array"
        datetime createdAt
        datetime updatedAt
    }

    REPORTS {
        ObjectId _id PK
        ObjectId reporterId FK
        string targetType "post comment recipe user"
        ObjectId targetId FK "polymorphic target"
        string reason
        string description
        string status
        ObjectId resolvedBy FK "admin User"
        string resolutionNotes
        datetime resolvedAt
        string targetPreview
        datetime createdAt
        datetime updatedAt
    }

    NOTIFICATIONS {
        ObjectId _id PK
        ObjectId userId FK
        string title
        string body
        string type
        object data "mixed embedded payload"
        boolean isRead
        datetime createdAt
        datetime updatedAt
    }

    STORES {
        ObjectId _id PK
        string name
        string brand
        string address
        string openHours
        string phone
        string logo
        object location "embedded GeoJSON Point"
        boolean isActive
        datetime createdAt
        datetime updatedAt
    }

    SYSTEMSETTINGS {
        ObjectId _id PK
        string key UK
        string appName
        string appVersion
        string geminiApiKey
        string cloudinaryName
        string pushServiceKey
        string visionEndpoint
        object aiConfig "embedded AI configuration"
        datetime createdAt
        datetime updatedAt
    }

    USERS ||--o{ PASSWORDRESETOTPS : requests_by_email
    USERS ||--o{ RECIPES : authors
    USERS }o--o{ RECIPES : favorites
    CATEGORIES ||--o{ RECIPES : classifies_by_code
    CATEGORIES ||--o{ INGREDIENTS : groups_by_code

    USERS ||--|| USERFRIDGES : owns
    INGREDIENTS o|--o{ USERFRIDGES : referenced_in_embedded_items
    USERS ||--o{ COOKING_HISTORIES : records
    RECIPES ||--o{ COOKING_HISTORIES : cooked_as
    USERS ||--o{ SCANHISTORIES : creates
    USERS ||--o{ MEALPLANS : plans
    RECIPES o|--o{ MEALPLANS : referenced_in_embedded_slots
    USERS ||--o{ CARTITEMS : owns
    RECIPES o|--o{ CARTITEMS : generates

    USERS ||--o{ POSTS : publishes
    RECIPES o|--o{ POSTS : shared_in
    USERS }o--o{ POSTS : reacts_via_embedded_map
    POSTS ||--o{ COMMENTS : receives
    USERS ||--o{ COMMENTS : writes
    COMMENTS o|--o{ COMMENTS : replies_to
    USERS }o--o{ CONVERSATIONS : participates
    CONVERSATIONS ||--o{ MESSAGES : contains
    USERS ||--o{ MESSAGES : sends
    USERS }o--o{ MESSAGES : reads

    USERS ||--o{ REPORTS : submits
    USERS o|--o{ REPORTS : resolves_as_admin
    POSTS o|--o{ REPORTS : polymorphic_target
    COMMENTS o|--o{ REPORTS : polymorphic_target
    RECIPES o|--o{ REPORTS : polymorphic_target
    USERS o|--o{ REPORTS : polymorphic_target
    USERS ||--o{ NOTIFICATIONS : receives

    USERS o|--o{ USERS : soft_deleted_by_admin
    USERS o|--o{ RECIPES : soft_deletes
    USERS o|--o{ POSTS : soft_deletes
    USERS o|--o{ COMMENTS : soft_deletes

